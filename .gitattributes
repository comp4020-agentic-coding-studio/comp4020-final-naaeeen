# Git for Windows checks out text files with CRLF by default
# (core.autocrlf=true), but sh can't run a script whose lines end in \r.
# Force LF for the hooks so the pre-commit guard works on Windows too.
.githooks/* text eol=lf

# Preserve byte-exact historical imports and their SHA manifests.
docs/planning-source/** -text

# Keep the original licensed asset bytes; vendor licence whitespace is deliberate.
public/assets/kaykit/** -text
public/assets/kaykit/LICENSE.txt -whitespace
