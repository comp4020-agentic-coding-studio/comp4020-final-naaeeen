# Git for Windows checks out text files with CRLF by default
# (core.autocrlf=true), but sh can't run a script whose lines end in \r.
# Force LF for the hooks so the pre-commit guard works on Windows too.
.githooks/* text eol=lf

# Preserve byte-exact historical imports and their SHA manifests.
docs/planning-source/** -text

# Keep the original licensed asset bytes; vendor licence whitespace is deliberate.
public/assets/kaykit/** -text
public/assets/kaykit/LICENSE.txt -whitespace

# Preserve the byte-frozen historical evaluator and its recorded CRLF digest.
docs/crit-9/round-2/evidence/delivery-probe/first-run-precomputed-calibration/probe.mjs -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Frozen unified-diff evidence uses a single space for blank context lines.
# Preserve its bytes; normal source whitespace and credential checks still apply.
docs/post-crit/evidence/*.patch -text whitespace=-blank-at-eol

# Preserve the recorded bytes of these two archived protocol preparation files.
# Ordinary source, whitespace and secret checks remain enabled.
docs/post-crit/evidence/picture-group-native-preparation-v1/preparation.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/post-crit/evidence/picture-group-native-preparation-v1/protocol.md -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Runtime source manifests must match both WSL and CI checkout bytes.
# Preserve separately frozen imports/assets/evidence rules above.
src/*.ts text eol=lf
public/*.js text eol=lf
public/*.css text eol=lf
public/*.html text eol=lf
tools/*.mjs text eol=lf
spec/*.ts text eol=lf
tests/**/*.ts text eol=lf

# Preserve captured proof/preimage bytes; canonical runtime files use LF above.
docs/spatial-redesign/evidence/** -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Exact newline preimages retain their existing terminal blank lines.
docs/spatial-redesign/evidence/lf-source-preimages/** -text whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof
docs/spatial-redesign/evidence/lf-test-preimages/** -text whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof
