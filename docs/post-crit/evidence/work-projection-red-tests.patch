+describe("own-work projection transport boundaries", () => {
+  test("retains ordering through actual zone/disconnect calls while observers read without saving or persisting the projection", async () => {
+    const storage = memoryStorage(); const transport = mockTransport(workSnapshot({ zone: "lounge", workSequence: 5, card: workCard("current") }));
+    const states: any[] = []; const client = createHouseClient({ storage, onSnapshot: value => states.push(value) }); await client.connect();
+    transport.state(workSnapshot({ access: 2, zone: "private", workSequence: 4, card: workCard("delayed") })); await client.subscribe("private");
+    expect(states.at(-1).durable.ownWork.card.id).toBe("current");
+    transport.emit("disconnect", "transport close"); expect(states.at(-1)).toBeNull();
+    transport.state(workSnapshot({ access: 3, generation: 2, controller: false, workSequence: 6, card: workCard("observer work") }));
+    transport.emit("connect", undefined); await vi.waitFor(() => expect(states.at(-1)?.durable.ownWork.sequence).toBe(6));
+    expect(states.at(-1).controller).toBe(false);
+    await expect(client.command({ type: "card.put", payload: { smallGoal: "observer draft" } })).rejects.toMatchObject({ code: "NOT_CONTROLLER" });
+    expect(transport.calls.filter(call => call.event === "house.command")).toHaveLength(0);
+    transport.emit("house.snapshot", workSnapshot({ access: 2, generation: 9, workSequence: 100 }));
+    transport.emit("house.snapshot", workSnapshot({ access: 3, generation: 1, workSequence: 100 }));
+    expect(states.at(-1).durable.ownWork.sequence).toBe(6);
+    transport.emit("house.snapshot", workSnapshot({ access: 3, generation: 3, workSequence: 7, card: workCard("controlling work") }));
+    await vi.waitFor(() => expect(transport.calls.filter(call => call.event === "house.command")).toHaveLength(1));
+    expect(transport.calls.find(call => call.event === "house.command")!.value).toMatchObject({ generation: 3, zoneId: "private", command: { payload: { smallGoal: "observer draft" } } });
+    expect(states.at(-1).durable.ownWork.card.id).toBe("controlling work");
+    expect(storage.getItem("house.ownWork")).toBeNull();
+    expect(storage.getItem(OUTBOX_STORAGE_KEY) ?? "").not.toContain("controlling work"); client.close();
+  });
