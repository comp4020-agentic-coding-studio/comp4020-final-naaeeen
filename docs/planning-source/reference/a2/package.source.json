    "astro-theme-slop": "github:benswift/astro-theme-slop#v0.1.0",
    "astro-theme-university": "git+https://github.com/ANUcybernetics/astro-theme-university.git#v0.13.2",
    "astromotion": "git+https://github.com/ANUcybernetics/astromotion.git#v0.23.0",
    "gsap": "3.15.0",
    "sharp": "^0.35.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "lightningcss": "^1.32.0",
    "pagefind": "^1.5.2",
    "parse5": "8.0.1",
    "typescript": "^6.0.3",
